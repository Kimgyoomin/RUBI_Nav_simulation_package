<?xml version="1.0"?>
<package format="3">
  <name>rubi_mujoco_sim</name>
  <version>0.1.0</version>
  <description>MuJoCo model smoke runner and canonical ROS 2 controller for RUBI.</description>

  <maintainer email="jang990608@gmail.com">RCLab</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>ament_index_cpp</depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rosgraph_msgs</depend>
  <depend>rubi_control_core</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <test_depend>ament_cmake_test</test_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
