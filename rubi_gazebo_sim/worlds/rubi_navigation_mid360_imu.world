<?xml version="1.0"?>
<sdf version="1.6">
  <world name="rubi_gazebo_legacy_policy_mid360_imu_world">
    <physics name="default_physics" default="1" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.0</sor>
          <use_dynamic_moi_rescaling>false</use_dynamic_moi_rescaling>
        </solver>
      </ode>
    </physics>

    <model name="box">
      <!-- <pose>0 0 0.2 0 0 0</pose> -->
      <pose>-7 5.7 0.2 0 0 0</pose>
      <static>true</static>
      <link name="box_link">
        <collision name="box_collision">
          <geometry><box><size>0.35 0.35 0.45</size></box></geometry>
        </collision>
        <visual name="box_visual">
          <geometry><box><size>0.35 0.35 0.45</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>
    <include>
      <uri>model://RUBI_mid360_imu</uri>
      <!-- <pose>0 0 0.64 0 0 0</pose> -->
      <pose>-7 5.7 0.64 0 0 0</pose>
      <plugin name="legacy_policy_controller"
              filename="librubi_gazebo_legacy_policy_plugin.so">
        <ros><namespace>/rubi_gazebo_legacy</namespace></ros>
      </plugin>
      <plugin name="gazebo_ros_p3d" filename="libgazebo_ros_p3d.so">
        <ros>
          <namespace>/</namespace>
          <remapping>odom:=ground_truth/odom</remapping>
        </ros>
        <frame_name>world</frame_name>
        <body_name>BODY</body_name>
        <update_rate>30.0</update_rate>
        <gaussian_noise>0.0</gaussian_noise>
      </plugin>
    </include>

    <!-- Static navigation test environment -->
    <include>
      <uri>model://corridor_nav</uri>
      <name>corridor_nav</name>

      <!-- All primitives are 1 m high and centered at local z=0 -->
      <pose>0 0 0.0 0 0 0</pose>

      <!-- Explicit override for safety -->
      <static>true</static>
    </include>
  </world>
</sdf>
