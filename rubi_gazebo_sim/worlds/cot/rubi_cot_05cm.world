            <csv_file_name>/tmp/rubi_mid360_imu_mid360.csv</csv_file_name>
            <topic>/livox/lidar_raw</topic>
          </plugin>
          <ray>
            <scan>
              <horizontal>
                <samples>640</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0</min>
              <max>0</max>
            </range>
          </ray>
        </sensor>
        <sensor name="mid360_imu" type="imu">
          <pose>0.011 0.02329 -0.04412 0 -0 0</pose>
          <always_on>1</always_on>
          <update_rate>200</update_rate>
          <visualize>0</visualize>
          <imu>
            <angular_velocity>
              <x>
                <noise type="gaussian">
                  <mean>0</mean>
                  <stddev>0</stddev>
                </noise>
              </x>
              <y>
                <noise type="gaussian">
                  <mean>0</mean>
                  <stddev>0</stddev>
                </noise>
              </y>
              <z>
                <noise type="gaussian">
                  <mean>0</mean>
                  <stddev>0</stddev>
                </noise>
              </z>
            </angular_velocity>
            <linear_acceleration>
              <x>
                <noise type="gaussian">
                  <mean>0</mean>
                  <stddev>0</stddev>
                </noise>
              </x>
              <y>
                <noise type="gaussian">
                  <mean>0</mean>
                  <stddev>0</stddev>
                </noise>
              </y>
              <z>
                <noise type="gaussian">
                  <mean>0</mean>
                  <stddev>0</stddev>
                </noise>
              </z>
            </linear_acceleration>
          </imu>
          <plugin name="mid360_imu_ros" filename="libgazebo_ros_imu_sensor.so">
            <ros>
              <namespace>/</namespace>
              <remapping>~/out:=/livox/imu_raw</remapping>
            </ros>
            <initial_orientation_as_reference>0</initial_orientation_as_reference>
            <frame_name>livox_frame_raw</frame_name>
          </plugin>
        </sensor>
        <self_collide>0</self_collide>
        <enable_wind>0</enable_wind>
        <kinematic>0</kinematic>
      </link>
      <joint name="livox_frame_raw_joint" type="fixed">
        <parent>BODY</parent>
        <child>livox_frame_raw</child>
      </joint>
      <frame name="livox_frame" attached_to="BODY">
        <pose relative_to="BODY">0.101 0 -0.1169 0 -0 0</pose>
      </frame>
      <frame name="L_TIP_JOINT" attached_to="L_CALF">
        <pose>0 0 -0.3 0 -0 0</pose>
      </frame>
      <frame name="L_TIP" attached_to="L_TIP_JOINT" />
      <frame name="R_TIP_JOINT" attached_to="R_CALF">
        <pose>0 0 -0.3 0 -0 0</pose>
      </frame>
      <frame name="R_TIP" attached_to="R_TIP_JOINT" />
      <pose>-2.0 0.0 0.64 0.0 0.0 0.0</pose>
      <plugin name="legacy_policy_controller" filename="librubi_gazebo_legacy_policy_plugin.so">
        <ros>
          <namespace>/rubi_gazebo_legacy</namespace>
        </ros>
      </plugin>
      <plugin name="gazebo_ros_p3d" filename="libgazebo_ros_p3d.so">
        <ros>
          <namespace>/</namespace>
          <remapping>odom:=ground_truth/odom</remapping>
        </ros>
        <frame_name>world</frame_name>
        <body_name>BODY</body_name>
        <update_rate>30.0</update_rate>
        <gaussian_noise>0.0</gaussian_noise>
      </plugin>
    </model>
