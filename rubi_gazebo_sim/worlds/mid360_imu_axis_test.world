<?xml version="1.0"?>
<sdf version="1.6">
  <world name="mid360_imu_axis_test_world">
    <gravity>0 0 0</gravity>
    <physics name="axis_test_physics" default="1" type="ode">
      <max_step_size>0.001</max_step_size>
