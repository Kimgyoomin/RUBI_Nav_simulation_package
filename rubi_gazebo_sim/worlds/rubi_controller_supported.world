<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="rubi_controller_supported_world">
    <physics name="default_physics" default="1" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.0</sor>
          <use_dynamic_moi_rescaling>false</use_dynamic_moi_rescaling>
        </solver>
      </ode>
    </physics>

    <model name="rubi_support_fixture">
      <pose>0.0285 0 0.264 0 0 0</pose>
      <static>true</static>
      <link name="support_link">
        <collision name="support_collision">
          <geometry><box><size>1.0 0.20 0.528</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <bounce><restitution_coefficient>0</restitution_coefficient></bounce>
          </surface>
        </collision>
        <visual name="support_visual">
          <geometry><box><size>1.0 0.20 0.528</size></box></geometry>
          <material>
            <ambient>0.25 0.35 0.42 1</ambient>
            <diffuse>0.35 0.50 0.58 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>
    <include>
      <uri>model://RUBI</uri>
      <pose>0 0 0.64 0 0 0</pose>
      <plugin name="experimental_unified_policy_controller"
              filename="librubi_unified_policy_plugin.so">
        <ros><namespace>/rubi_gazebo_supported</namespace></ros>
      </plugin>
    </include>
  </world>
</sdf>
